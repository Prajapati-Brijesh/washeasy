# WashEasy Environment Variables

# Server Port
PORT=3000

# MongoDB Connection String (Local or MongoDB Atlas Cloud)
# For Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/washeasy?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/washeasy

# JWT Secret for Authentication
JWT_SECRET=washeasy_secret_key_2026

# Environment
NODE_ENV=production
